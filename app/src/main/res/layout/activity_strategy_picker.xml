<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/zapret_mist">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/strategy_auto_card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/zapret_porcelain" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" app:strokeColor="@color/zapret_line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/strategy_auto" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/zapret_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/strategy_auto_description" android:textSize="12sp"
                        android:textColor="@color/zapret_muted" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/strategy_balanced_card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/zapret_porcelain" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" app:strokeColor="@color/zapret_line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/strategy_balanced" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/zapret_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/strategy_balanced_description" android:textSize="12sp"
                        android:textColor="@color/zapret_muted" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/strategy_split_card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/zapret_porcelain" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" app:strokeColor="@color/zapret_line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/strategy_split" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/zapret_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/strategy_split_description" android:textSize="12sp"
                        android:textColor="@color/zapret_muted" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/strategy_tls_card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/zapret_porcelain" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" app:strokeColor="@color/zapret_line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/strategy_tls" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/zapret_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/strategy_tls_description" android:textSize="12sp"
                        android:textColor="@color/zapret_muted" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/strategy_messaging_card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/zapret_porcelain" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" app:strokeColor="@color/zapret_line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/strategy_messaging" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/zapret_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/strategy_messaging_description" android:textSize="12sp"
                        android:textColor="@color/zapret_muted" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/strategy_games_card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/zapret_porcelain" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" app:strokeColor="@color/zapret_line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/strategy_games" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/zapret_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/strategy_games_description" android:textSize="12sp"
                        android:textColor="@color/zapret_muted" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/strategy_strong_card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:clickable="true" android:focusable="true"
                app:cardBackgroundColor="@color/zapret_porcelain" app:cardCornerRadius="8dp"
                app:cardElevation="0dp" app:strokeColor="@color/zapret_line" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp" android:importantForAccessibility="noHideDescendants">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/strategy_strong" android:textSize="16sp" android:fontFamily="sans-serif-medium"
                        android:textColor="@color/zapret_ink" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/strategy_strong_description" android:textSize="12sp"
                        android:textColor="@color/zapret_muted" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/strategy_apply_button"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" android:layout_marginBottom="16dp" android:text="@string/strategy_apply"
        android:textAllCaps="false" android:textColor="@color/zapret_mist"
        app:backgroundTint="@color/zapret_violet" app:cornerRadius="8dp" />
</LinearLayout>
